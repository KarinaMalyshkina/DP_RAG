+def _sample_threshold_log_space(sorted_scores, sorted_utilities, epsilon):
+    """Draw the threshold from exp(epsilon*u/2) weighted by interval width, in log space.
+
+    Mathematically identical to normalising ``exp(eps*u/2) * width`` directly; only
+    the arithmetic differs, and on a duplicated corpus the arithmetic is the whole
+    problem. Duplication makes the score distribution atomic: with every document
+    repeated ten times, 11000 scores produce ~939 intervals of nonzero width, and
+    the exponential weight concentrates on the few near the top-k boundary. Their
+    product underflows float64 -- measured sums of 1e-95 down to 1e-102, and for 11
+    of 60 target queries an exact 0, which made ``pdf /= sum`` produce NaN and
+    ``np.random.choice`` raise "probabilities contain NaN". Three cells of the
+    Gemma 4 matrix died that way at duplication_rate=1.0, n_copies=10, eps=5.
+
+    Subtracting the maximum before exponentiating removes the underflow without
+    touching the distribution: the same relative weights, so the same mechanism and
+    the same privacy guarantee. A zero-width interval is an impossible outcome
+    rather than an unlikely one, and log(0) = -inf gives it probability 0, which is
+    what the direct form intended.
+
+    Deviation from upstream (sarus-tech/dp-rag), numerical only.
+    """
+    with np.errstate(divide="ignore"):
+        log_weights = epsilon * sorted_utilities[:-1] / 2 + np.log(np.diff(sorted_scores))
+    log_weights = np.where(np.isfinite(log_weights), log_weights, -np.inf)
+    peak = log_weights.max()
+    if not np.isfinite(peak):
+        # Every interval is degenerate: after clipping, all scores are equal and the
+        # threshold distribution has no support at all. Raising beats returning an
+        # arbitrary threshold, which would silently spend budget on nothing.
+        raise ValueError(
+            "DP retrieval threshold has no support: every score interval has zero width. "
+            "The corpus is fully degenerate at this duplication level."
+        )
+    pdf = np.exp(log_weights - peak)
+    pdf /= pdf.sum()
+    return np.random.choice(sorted_scores[:-1], p=pdf)
+
