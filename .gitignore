# --- Transient artifacts ---------------------------------------------------
# Experiment results under runs/ ARE tracked on purpose (see commit e20518d);
# only throwaway and machine-generated artifacts are listed here.

# Atomic-write leftovers. CheckpointedRun writes results.tmp and renames it, so a
# run killed mid-write leaves one behind.
*.tmp

# Written by scripts/bootstrap_gpu.sh with paths specific to the rented machine.
.env.gpu
.env.secrets

# HuggingFace cache, if WORKSPACE ever resolves inside the repo.
hf-cache/

# Scratch sweeps used to smoke-test the runners — not results.
runs/m_*/
runs/plan_smoke/
runs/canary_smoke2/
# Convention for future throwaway runs: --output-dir runs/scratch_<whatever>
runs/scratch_*/

# Thesis and report deliverables. Not part of the framework's source: a .docx cannot
# be diffed or reviewed, and mixing the write-up into the code history makes both
# harder to read. These stay in the working tree and are never committed.
docs/*.docx
scripts/build_methodology_docx.py

# Result files staged for writing the thesis text. Every file under docs_vkr/ is a
# copy of, or is derived from, something already under runs/ — so ignoring it loses
# no data, and tracking it would duplicate multi-megabyte prediction dumps in the
# history under a second name.
docs_vkr/

# Word lock/temp files, created while a document is open.
~$*
